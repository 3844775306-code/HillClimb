[input_devices]

; 手指按下时**再补一个合成鼠标事件**。整套路（菜单、商店、车库）只认鼠标事件，
; 靠的就是这一条：界面不再自己接 InputEventScreenTouch，一次点按只有一条路径。
; 这是引擎的默认值，但既然整套手机输入压在它上面，就写出来、并且由 tests/tap 断言 ——
; 谁把它改成 false，安卓上所有按钮都会失灵，那种坏法在桌面上看不出来。
pointing/emulate_mouse_from_touch=true

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
environment/defaults/default_clear_color=Color(0.53, 0.78, 0.92, 1)
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
