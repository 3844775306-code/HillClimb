polygon = PackedVector2Array(-14, 22, -6, -20, 6, -20, 14, 22)

; 陀螺仪：画在立柱中段的一圈亮色带子。**纯装饰**，碰撞形状里没有它
; —— 和 Cab / Seat / Wing 那些一样，只是让玩家看得出这辆车装了什么。
[node name="Gyro" type="Polygon2D" parent="Chassis"]
color = Color(0.24, 0.78, 0.82, 1)
polygon = PackedVector2Array(-11, -2, -8, -12, 8, -12, 11, -2)

[node name="SeatPost" type="Polygon2D" parent="Chassis"]
color = Color(0.55, 0.58, 0.64, 1)
polygon = PackedVector2Array(-11, 16, -3, -14, 3, -14, 11, 16)

; 车座：比立柱宽出来一圈，好让「车手坐在上面」这件事一眼看得出来。
[node name="Saddle" type="Polygon2D" parent="Chassis"]
color = Color(0.12, 0.12, 0.15, 1)
polygon = PackedVector2Array(-23, -21, -16, -31, 16, -31, 23, -21)

; 车手的原点在胯下，身体画在原点上方 22 px 处（见 driver_visual.gd）。
; 车座顶面在 -31，所以原点放 -25：身体底边落在 -21，正好坐在座垫上。
[node name="Driver" type="Node2D" parent="Chassis"]
position = Vector2(0, -25)
script = ExtResource("3_driver")

; 头必须在 Driver 正上方**整整 36 px**（driver_visual.gd 的 HEAD_CENTER）。
[node name="Head" type="Area2D" parent="Chassis"]
position = Vector2(0, -61)
collision_layer = 0
collision_mask = 2

[node name="HeadShape" type="CollisionShape2D" parent="Chassis/Head"]
shape = SubResource("CS_head")

; **只有一个轮子，而且名字就叫 RearWheel。**
;
; 名字不是笔误：`Vehicles.stats` 取轮半径、`tests/vehicles` 的契约、还有几处
; 绝对节点路径都认这个名字，改成 `Wheel` 要动的地方比收益多。它同时是后轮和前轮
; —— `rear_wheel` / `front_wheel` 两个别名都指向它。
[node name="RearWheel" type="RigidBody2D" parent="." groups=["wheel"]]
position = Vector2(0, 26)
collision_layer = 1
collision_mask = 3
mass = 16.0
physics_material_override = SubResource("PM_wheel")
continuous_cd = 2
contact_monitor = true
max_contacts_reported = 4
can_sleep = false

[node name="Shape" type="CollisionShape2D" parent="RearWheel"]
shape = SubResource("CS_wheel")

[node name="Visual" type="Node2D" parent="RearWheel"]
script = ExtResource("2_wheel")
radius = 28.0
tire_color = Color(0.11, 0.11, 0.14, 1)
rim_color = Color(0.76, 0.78, 0.82, 1)
