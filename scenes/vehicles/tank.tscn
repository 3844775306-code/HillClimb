polygon = PackedVector2Array(-82, 6, -82, -26, -66, -36, 60, -36, 82, -22, 82, 6)

; 下面四块都是**纯装饰**，碰撞形状里没有它们（和越野车的 Cab / 摩托的 Tank 一样）。
[node name="TrackGuard" type="Polygon2D" parent="Chassis"]
