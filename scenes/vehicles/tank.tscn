polygon = PackedVector2Array(24, -48, 88, -52, 88, -44, 24, -40)

[node name="Hatch" type="Polygon2D" parent="Chassis"]
color = Color(0.22, 0.25, 0.18, 1)
polygon = PackedVector2Array(-14, -54, -8, -60, 8, -60, 14, -54)

; 车手从炮塔顶盖里探出来 —— 坦克没这个必要，但**「头碰到地面就算翻车」是这游戏
; 最经典的一条规则**（见 car.gd 的 REASON_CRASH），得有个头露在外面才能成立。
;
; 原点在胯下、身体画在上方 22 px（driver_visual.gd）。炮塔顶面 -54，所以原点放 -34：
; 身体落在 -30 ~ -56，脑袋整个探在顶盖上面。
[node name="Driver" type="Node2D" parent="Chassis"]
position = Vector2(0, -34)
script = ExtResource("3_driver")

; 头必须在 Driver 正上方**整整 36 px**（driver_visual.gd 的 HEAD_CENTER）。
[node name="Head" type="Area2D" parent="Chassis"]
position = Vector2(0, -70)
collision_layer = 0
collision_mask = 2

[node name="HeadShape" type="CollisionShape2D" parent="Chassis/Head"]
shape = SubResource("CS_head")

[node name="RearWheel" type="RigidBody2D" parent="." groups=["wheel"]]
position = Vector2(-50, 14)
collision_layer = 1
